{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "root": false,
  "files": {
    "includes": [
      "app/**",
      "components/**",
      "lib/**",
      "i18n/**",
      "proxy.ts",
      "global.d.ts",
      "messages/**",
      "!**/.next/**",
      "!**/node_modules/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}

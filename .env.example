# ── Required ──────────────────────────────────────────────────────────
# Telegram MTProto credentials — obtain at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Public URL of this deployment (used in OAuth issuer, SEO canonical URLs,
# landing/privacy/terms links, MCP icon URL). No trailing slash.
ISSUER=https://your-domain.example.com

# ── Server ────────────────────────────────────────────────────────────
PORT=3000
# Display name shown on landing page, MCP server metadata, <title> tags.
BRAND_NAME=MCP Telegram

# ── Contact (optional — shown on landing/privacy/terms) ──────────────
# Leave empty if self-hosting without public contact surface.
CONTACT_EMAIL=
CONTACT_TELEGRAM=

# ── Source links (optional — used in landing/Privacy/Terms) ────────
# Override if you maintain a fork or want users to file issues elsewhere.
# SOURCE_REPO_URL defaults to the canonical upstream cloud repo.
# ISSUES_URL defaults to {SOURCE_REPO_URL}/issues.
# ISSUES_LABEL is the visible link text — change in lockstep with ISSUES_URL
# so a non-GitHub tracker doesn't ship the "GitHub Issues" label.
# Both URLs MUST be http:/https: schemes — invalid values refuse to boot
# (anchor href XSS guard).
SOURCE_REPO_URL=
ISSUES_URL=
ISSUES_LABEL=

# ── Admin ─────────────────────────────────────────────────────────────
# Bearer token for /api/stats and /api/import-session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ── Session encryption (at rest) ──────────────────────────────────────
# 32-byte key that encrypts Telegram session strings (= full account access)
# in cloud.db. A stolen disk/backup is then useless without this key. Generate:
#   openssl rand -base64 32
# In production inject this from a secret store (e.g. GitHub Secret → deploy
# env) so it lives only in process memory, NEVER on the VDS disk or in a backup.
# Empty = PASSTHROUGH: session strings stored in plaintext + a startup warning.
# Only leave empty for local dev / single-user self-host where the disk is yours.
# Losing this key means every stored session is unreadable → users re-login via
# QR (no data loss, just a re-auth). Keep a backup of the key in ≥2 safe places.
SESSION_ENCRYPTION_KEY=

# ── Observability (optional — privacy-first defaults) ───────────────
# Master kill-switch for outbound telemetry. Default: local-only.
#   local-only — SQLite + console + in-memory error buffer; ZERO outbound.
#   on         — same + OTLP HTTP exporter to SigNoz (needs SIGNOZ_ENDPOINT).
#   off        — silent (no console, no OTLP). SQLite usage_log still on.
# /api/observability HTML page works in any mode.
MCP_TELEGRAM_TELEMETRY=local-only
# SigNoz / OTLP HTTP endpoint (no trailing slash). Used only when
# MCP_TELEGRAM_TELEMETRY=on.
SIGNOZ_ENDPOINT=
# Optional HTTP Basic auth credentials for the OTLP endpoint above.
# Format: "user:password". Empty = no Authorization header sent.
SIGNOZ_AUTH=
LOG_SERVICE_NAME=mcp-telegram-cloud
# Default = HMAC-hashed user IDs (LOG_HASH_SALT). Set to "true" only for short
# local debugging — never in production.
LOG_USER_IDS=
# HMAC key for hashed-user-id mode. Prevents rainbow-table lookup of hashes
# back to Telegram user IDs (numeric space is small). Rotate per deployment.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOG_HASH_SALT=

# ── OpenAI Apps (optional) ────────────────────────────────────────────
# Domain verification challenge served at /.well-known/openai-apps-challenge.
# Leave empty if not submitting to ChatGPT Apps Directory (endpoint 404s).
OPENAI_APPS_CHALLENGE=

# ── Storage ───────────────────────────────────────────────────────────
# SQLite database path. Directory must exist and be writable.
DATABASE_PATH=./data/cloud.db
# Days to retain usage_log rows. 0 = keep forever (not recommended).
USAGE_LOG_RETENTION_DAYS=90

# ── Rate Limiting ─────────────────────────────────────────────────────
# Per-user daily tool call quota.
FREE_TIER_LIMIT=100
# IP rate limit on /oauth/* endpoints (requests per window per IP).
# 0 disables the limiter. Defaults protect register/token/revoke/authorize
# from bot abuse while leaving room for legitimate retries.
OAUTH_RATE_LIMIT=30
OAUTH_RATE_WINDOW_MS=60000

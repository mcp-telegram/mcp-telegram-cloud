{
  "name": "mcp-telegram-cloud",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.tsx",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",

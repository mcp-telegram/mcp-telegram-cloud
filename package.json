{
  "name": "mcp-telegram-cloud",
  "version": "2.54.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "web",
    "app"
  ],
  "scripts": {
    "dev": "bun --hot src/server.tsx",
    "start": "bun src/server.tsx",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel ./src/__tests__/",
    "check-parity": "bun scripts/check-parity.ts",
    "check-telemetry": "bun scripts/check-telemetry.ts",
    "check-traefik-parity": "bun scripts/check-traefik-parity.ts",
    "lint": "biome check src/ scripts/",
    "lint:fix": "biome check --write src/ scripts/",
    "format": "biome format --write src/ scripts/",
    "prepare": "husky",
    "web:dev": "bun --filter mcp-telegram-web dev",
    "web:build": "bun --filter mcp-telegram-web build",
    "web:start": "bun --filter mcp-telegram-web start",
    "web:lint": "bun --filter mcp-telegram-web lint",
    "web:typecheck": "bun --filter mcp-telegram-web typecheck",
    "app:dev": "bun --filter mcp-telegram-app dev",
    "app:build": "bun --filter mcp-telegram-app build",
    "app:lint": "bun --filter mcp-telegram-app lint",
    "app:typecheck": "bun --filter mcp-telegram-app typecheck",
    "app:test": "bun --filter mcp-telegram-app test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@overpod/mcp-telegram": "^1.41.5",
    "dotenv": "^17.4.2",
    "hono": "^4.13.4",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "fast-uri@<3.1.2": ">=3.1.2",
    "ip-address@<10.2.0": ">=10.2.0",
    "postcss": ">=8.5.10"
  }
}

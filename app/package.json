{
  "name": "mcp-telegram-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.ssr.config.ts",
    "build:client": "vite build",
    "build:ssr": "vite build --config vite.ssr.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/__tests__/",
    "lint": "biome check src vite.config.ts vite.ssr.config.ts"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "6.0.3",
    "vite": "^8.0.16"
  }
}

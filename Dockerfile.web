## Dockerfile for the Next.js content site (mcp-telegram-web).
##
## Build context is the cloud root because of the Bun workspace shape — the
## monorepo's `package.json + bun.lock` define the workspace, and `web/` is
## the actual Next.js package. We need both for `bun install` to resolve.
##
## Fully Bun: deps via bun install, build via `bunx next build` (Next 16.3+
## supports it), runtime via Bun's standalone execution. No node:* stages.

# Stage 1: Install workspace deps (root + web + app manifests for full graph).
# --ignore-scripts skips native compilation of optional ws speedups
# (utf-8-validate, bufferutil) — they need Python+gcc; the JS fallback is
# functionally identical.
FROM oven/bun:1.4.0-alpine AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY web/package.json ./web/
COPY app/package.json ./app/
RUN bun install --frozen-lockfile --ignore-scripts

# Stage 2: Run `next build` to produce a standalone output.
FROM oven/bun:1.4.0-alpine AS builder
WORKDIR /app
COPY package.json bun.lock ./
COPY web ./web
# Bun does NOT hoist workspace deps to the root like npm: next/next-intl/react
# live in web/node_modules, so both trees must come across.
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/web/node_modules ./web/node_modules
ENV NEXT_TELEMETRY_DISABLED=1
# Analytics IDs are baked at build time: the content pages are statically
# prerendered (SSG via generateStaticParams), so `process.env` is read once
# during `next build`, not per-request. These are public tracking IDs (not
# secrets) and default empty — an unset arg yields a tracker-free build, which
# keeps the OSS image clean for self-hosters. CI passes them from repo vars;
# runtime container env has no effect on SSG output.
ARG METRIKA_ID=""
ARG GA4_ID=""
ENV METRIKA_ID=${METRIKA_ID}
ENV GA4_ID=${GA4_ID}
WORKDIR /app/web
RUN bunx next build

# Stage 3: Production runtime — Bun executes the standalone server.
# Standalone output bundles the Node-style server.js + a trimmed
# node_modules tree. Static assets and public/ live alongside.
FROM oven/bun:1.4.0-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
# Standalone output co-locates a self-contained Node server + minimal
# node_modules tree. Static assets and public/ live alongside.
COPY --from=builder /app/web/.next/standalone ./
COPY --from=builder /app/web/.next/static ./web/.next/static
COPY --from=builder /app/web/public ./web/public
EXPOSE 3001
CMD ["bun", "web/server.js"]
